[Unit]
Description=Spectyn Mesh AI Agent Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spectyn
WorkingDirectory=/home/spectyn
ExecStart=/usr/bin/spectyn serve --host 0.0.0.0 --port 7878
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=HOME=/home/spectyn
EnvironmentFile=-/home/spectyn/.spectyn-mesh/env

# Hardening (2026-05-29 audit). ProtectSystem=full keeps /usr /boot /etc
# read-only while leaving /home/spectyn + /opt writable for the daemon's data
# + binary; the rest are no-cost confinement that the daemon does not need to
# violate. Tighten to ProtectSystem=strict + explicit ReadWritePaths later.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
# SPEC-44 reconcile (T-WL-05): this is the v0.5.0 **system** (VPS / cloud) unit —
# its canonical name stays `spectyn-mesh.service` (INSTALL-OCI + existing installs
# depend on it). SPEC-44 §G1/§G5 also name a **user** desktop unit `spectyn.service`
# (at ~/.config/systemd/user/, started with `systemctl --user`) — that one is a
# separate, still-unbuilt unit. The Alias below lets `systemctl start spectyn`
# resolve to this system unit too (on `systemctl enable` it creates a
# spectyn.service → spectyn-mesh.service symlink), reconciling the spec's short
# name without breaking the established `spectyn-mesh.service` name.
Alias=spectyn.service
