{
  "name": "phantommesh-io",
  "version": "0.4.0",
  "private": true,
  "description": "phantommesh.io — broker frontend + backend for phantom login",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "check:install": "tsx scripts/check-install-ps1.ts",
    "db:create": "wrangler d1 create phantommesh-prod",
    "db:migrate": "wrangler d1 execute phantommesh-prod --file=./migrations/0001_init.sql",
    "kv:create": "wrangler kv:namespace create SESSIONS"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.78.0"
  }
}
