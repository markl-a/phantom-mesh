# =============================================================================
# Phantom Mesh Agent Configuration (agents.toml)
# =============================================================================
#
# Copy this file to ~/.phantom-mesh/agents.toml and edit to match your setup.
# All API keys and credentials shown here are placeholders -- replace them
# with your own values before running the daemon.
#
# Documentation: https://github.com/markl-a/phantom-mesh
# =============================================================================


# -----------------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------------
# Controls the daemon's network binding and authentication.

[core]
host = "0.0.0.0"          # Bind address ("127.0.0.1" for local-only, "0.0.0.0" for cluster)
port = 7878                # HTTP API port
# hub_api_key = "your-secret-hub-key"   # Bearer token for API auth (optional)


# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------
# The primary user interface. Create a bot via @BotFather on Telegram.
# allowed_users restricts who can interact with the bot (Telegram usernames).
# An empty list denies all users.

[telegram]
bot_token = "YOUR_TELEGRAM_BOT_TOKEN"
allowed_users = ["your_telegram_username"]


# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------
# Configure one or more LLM backends. Each provider needs a unique name.
# Supported types: ollama, openai_compat, openai, anthropic, gemini, groq,
#                  chatgpt_backend, chatgpt_ws, codex, opencode
#
# API keys can be set directly or via environment variables.
# Use the "enc2:" prefix for encrypted secrets (see: phantom-mesh encrypt-secret).

# -- Local Providers (no API key needed) --

[providers.ollama]
type = "ollama"
url = "http://localhost:11434"
default_model = "llama3.2:8b"

[providers.lmstudio]
type = "openai_compat"
url = "http://localhost:1234"
# default_model = "qwen3-coder-next"

# -- Cloud Providers (API key required) --

[providers.gemini]
type = "gemini"
api_key = "YOUR_GEMINI_API_KEY"
default_model = "gemini-2.0-flash"

# [providers.openai]
# type = "openai"
# api_key = "YOUR_OPENAI_API_KEY"
# default_model = "gpt-4o"

# [providers.anthropic]
# type = "anthropic"
# api_key = "YOUR_ANTHROPIC_API_KEY"
# default_model = "claude-sonnet-4-6"

# [providers.groq]
# type = "groq"
# api_key = "YOUR_GROQ_API_KEY"
# default_model = "llama-3.3-70b-versatile"

# [providers.openrouter]
# type = "openai_compat"
# url = "https://openrouter.ai/api/v1"
# api_key = "YOUR_OPENROUTER_API_KEY"
# default_model = "meta-llama/llama-3.3-70b-instruct:free"

# -- ChatGPT Backend (uses Codex CLI OAuth tokens from ~/.codex/auth.json) --

# [providers.chatgpt]
# type = "chatgpt_backend"
# default_model = "gpt-4o"

# -- OpenCode CLI (free community models) --

# [providers.opencode]
# type = "opencode"
# default_model = "minimax-m2.5-free"


# -----------------------------------------------------------------------------
# Smart Routing (Tiered Request Classification)
# -----------------------------------------------------------------------------
# Automatically routes requests by complexity to the most cost-effective
# provider. A small local model classifies each request, then dispatches
# to the appropriate tier.

# [smart_routing]
# classifier_provider = "ollama"
# classifier_model = "llama3.2:1b"
# simple_providers = ["ollama", "lmstudio"]
# medium_providers = ["gemini", "groq"]
# complex_providers = ["chatgpt", "openai"]


# -----------------------------------------------------------------------------
# Agents
# -----------------------------------------------------------------------------
# Each agent has a provider, model, tool list, and system instructions.
# The "master" agent is the default entry point for Telegram and HTTP.
#
# Fields:
#   provider        - Which provider to use (must match a [providers.*] name)
#   model           - Model name (overrides the provider's default_model)
#   tools           - List of tool names this agent can use (empty = text-only)
#   instructions    - System prompt for this agent
#   subagents       - Other agents this agent can delegate to
#   daily_budget_usd - Max USD spend per day (0 = unlimited)
#   autonomy        - "full", "supervised", or "readonly"

[agent.master]
provider = "gemini"
model = "gemini-2.0-flash"
daily_budget_usd = 5.0
autonomy = "full"
subagents = ["coder", "researcher"]
tools = [
    "shell",
    "file_read",
    "file_write",
    "file_edit",
    "glob_search",
    "content_search",
    "web_search",
    "http_request",
    "memory_store",
    "memory_recall",
    "delegate",
    "delegate_to_provider",
    "run_hand",
]
instructions = """
You are Phantom Mesh, an autonomous AI agent running on the user's machine.
You coordinate subagents and use tools to complete tasks.
Always respond in the same language as the user.
Be concise, accurate, and helpful.
"""

[agent.coder]
provider = "ollama"
model = "llama3.2:8b"
daily_budget_usd = 0
autonomy = "full"
tools = ["shell", "file_read", "file_write", "file_edit", "ai_code"]
instructions = """
You are an expert programmer.
Write clean, efficient, well-tested code.
Use file_write to create files and shell to run commands.
"""

[agent.researcher]
provider = "gemini"
model = "gemini-2.0-flash"
daily_budget_usd = 2.0
autonomy = "full"
tools = ["web_search", "http_request", "memory_store", "memory_recall"]
instructions = """
You are a research agent. Gather information from the web,
synthesize findings, and store important facts in memory.
"""


# -----------------------------------------------------------------------------
# Cluster
# -----------------------------------------------------------------------------
# Distribute work across multiple machines. The "hub" coordinates tasks;
# "worker" nodes connect to the hub and execute delegated tool calls.
#
# Hub mode (default): runs the full daemon and dispatches to workers.
# Worker mode: connects to a hub and processes assigned tasks.

[cluster]
role = "hub"                            # "hub" or "worker"
# hub_url = "http://YOUR_HUB_IP:7878"  # Required when role = "worker"
# node_name = "my-worker"              # Auto-detected from hostname if not set


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Controls tool execution sandboxing and rate limits.

[security]
workspace_dir = "~/.phantom-mesh/workspace"  # Sandbox directory for file operations
workspace_only = true                    # Restrict file I/O to workspace_dir
allowed_commands = [                     # Shell allowlist (commands outside this list are blocked)
    "git", "python", "python3", "pip", "pip3",
    "cargo", "npm", "node", "npx",
    "ls", "dir", "cat", "head", "tail", "grep", "find", "echo",
    "mkdir", "cp", "mv", "pwd", "which", "where", "wc", "sort", "tree",
    "date", "time", "whoami", "hostname",
    "sqlite3", "jq",
]
# allowed_paths = ["/path/to/extra/allowed/dir"]  # Additional paths beyond workspace

[security.rate_limit]
max_actions_per_hour = 840              # Global tool call limit per hour
max_per_tool_per_hour = 280             # Per-tool call limit per hour


# -----------------------------------------------------------------------------
# Search (web_search tool)
# -----------------------------------------------------------------------------
# At least one search API key is needed for the web_search tool.
# Supports: Serper, Tavily, Brave Search, Exa, LangSearch.

# [search]
# serper_api_key = "YOUR_SERPER_API_KEY"
# tavily_api_key = "YOUR_TAVILY_API_KEY"
# brave_api_key = "YOUR_BRAVE_API_KEY"
# exa_api_key = "YOUR_EXA_API_KEY"
# langsearch_api_key = "YOUR_LANGSEARCH_API_KEY"


