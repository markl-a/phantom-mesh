SPRINT.md

# Distribution artifacts (use GitHub Releases instead)
dist/

# Test output / QA debris
test-results/
app/test-results/
app/qa-screenshots/
app/test_screenshots/
app/screenshots/archived-debug/

# E2E run results — local artifacts that embed hostname/user/path + secret notes.
# Keep the directory tracked (via .gitkeep) but never commit individual run logs.
tests-e2e/results/
!tests-e2e/results/.gitkeep

# Build logs
scripts/*.log
*.log

# Tauri generated artifacts (regenerated by build pipeline)
#   gen/android/ + gen/apple/  — full Tauri mobile projects
#   gen/schemas/                — capability schemas (~1 MB total) re-derived
#                                  from app/src-tauri/capabilities/*.json on
#                                  every build. The hand-edited capabilities/
#                                  files ARE tracked (see line ~145).
#   tsconfig.tsbuildinfo        — TypeScript incremental compile cache;
#                                  changes on every tsc invocation.
app/src-tauri/gen/android/
app/src-tauri/gen/apple/
app/src-tauri/gen/schemas/
app/tsconfig.tsbuildinfo

# Internal planning (decide before public push — see _planning-audit/MASTER-PLAN.md §10)
# _planning-audit/    # uncomment before public push

# Editor / OS noise
.DS_Store
*.swp
*.swo
*~

# Tauri sidecar binaries — populated by build.rs on each build
app/src-tauri/binaries/*
!app/src-tauri/binaries/.gitkeep

# Git worktrees (parallel feature development)
.worktrees/

# Cloudflare Workers local dev artifact (phantommesh-io)
.wrangler/

# -----------------------------------------------------------------------------
# TDD results log (append-only, cross-tool framework — see AGENTS.md §10)
# Last rule wins: explicitly re-include after the `*.log` blanket above.
# -----------------------------------------------------------------------------
!docs/tdd/results.log

# Local tooling configs (per-machine generated, do not sync)
.agents/
.codex/

# mesh-coord comms channel must stay tracked (overrides *.log etc)
!.ai-shared/mesh-coord/messages/
!.ai-shared/mesh-coord/messages/**

# AI scratch (subagent temp; never commit — can be large)
.ai-shared/tmp/
