# =============================================================================
# .gitignore - LLM Cluster Project (Open Source)
# =============================================================================

# -----------------------------------------------------------------------------
# Rust / clawtex-core (dir kept) / phantom-mesh
# -----------------------------------------------------------------------------
target/
target*/
clawtex-core/Cargo.lock
clawtex-zeroclaw/

# Stray repo-root junk that has bitten us before:
#   /main      — Mach-O binary accidentally committed in 107a5c5
#                (also conflicts with `main` branch name → makes git
#                ambiguous about whether `main` means a ref or a path)
#   /main.rs   — 5-line test file from the same accidental commit
#   /~/        — literal "tilde" dir created when something quoted "~"
#                in shell instead of letting it expand
# Anchored with leading `/` so deeper main.rs files (core/src/main.rs,
# app/src-tauri/src/main.rs) and any nested `main` are unaffected.
/main
/main.rs
/~/

# -----------------------------------------------------------------------------
# iOS / mobile build artifacts (unzipped IPA contents)
# -----------------------------------------------------------------------------
Payload/
ios-sandbox/
*.app/

