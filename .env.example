# ============================================================================
# Phantom Mesh Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# ── LLM Providers ────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=
# GROQ_API_KEY=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ALLOWED_USERS=comma,separated,usernames

# ── Cluster ──────────────────────────────────────────────────────────────────
# CLUSTER_SECRET=your-cluster-secret

# ── Server ───────────────────────────────────────────────────────────────────
API_PORT=7878

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=data/phantom-mesh.db

# ── Stripe (Revenue) ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Release / Signing (GitHub Actions) ──────────────────────────────────────
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID_HERE
ANDROID_KEY_ALIAS=phantom-mesh
# Use one naming style consistently in CI secrets:
# ANDROID_STORE_PASSWORD / ANDROID_KEY_PASSWORD (current workflow)
# ANDROID_KEYSTORE_PASS / ANDROID_KEY_PASS (legacy docs)
ANDROID_STORE_PASSWORD=your_keystore_password
ANDROID_KEY_PASSWORD=your_key_password
# TAURI_SIGNING_PRIVATE_KEY should be base64 of ~/.tauri/phantom-mesh.key
TAURI_SIGNING_PRIVATE_KEY=base64_of_tauri_signing_key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
