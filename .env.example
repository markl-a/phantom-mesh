# ============================================================================
# Phantom Mesh Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# ── LLM Providers ────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=
# GROQ_API_KEY=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ALLOWED_USERS=comma,separated,usernames

# ── Cluster ──────────────────────────────────────────────────────────────────
# CLUSTER_SECRET=your-cluster-secret

# ── Server ───────────────────────────────────────────────────────────────────
API_PORT=7878

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=data/phantom-mesh.db

# ── Stripe (Revenue) ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Release / Signing (GitHub Actions) ──────────────────────────────────────
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID_HERE
ANDROID_KEY_ALIAS=phantom-mesh
# Use one naming style consistently in CI secrets:
# ANDROID_STORE_PASSWORD / ANDROID_KEY_PASSWORD (current workflow)
# ANDROID_KEYSTORE_PASS / ANDROID_KEY_PASS (legacy docs)
ANDROID_STORE_PASSWORD=your_keystore_password
ANDROID_KEY_PASSWORD=your_key_password
# TAURI_SIGNING_PRIVATE_KEY should be base64 of ~/.tauri/phantom-mesh.key
TAURI_SIGNING_PRIVATE_KEY=base64_of_tauri_signing_key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ── Multi-Machine Dev Workflow (phantom-coord skill) ─────────────────────────
# Used by scripts/ai/coord/{leader,follower,dispatch-router}.sh.
# See docs/MULTI-DEVICE-COORDINATION.md for the full architecture.

# Repo path on this machine (auto-detected; override only if non-standard)
# PHANTOM_MESH_REPO=$HOME/path/to/phantom-mesh

# Backend CLI binary paths (auto-detected from PATH; override if installed elsewhere)
# CLAUDE_BIN=/Users/me/.local/bin/claude
# CODEX_BIN=/Users/me/.local/bin/codex
# AGY_BIN=$HOME/.local/bin/agy
# GEMINI_BIN=/opt/homebrew/bin/gemini
# OPENCODE_BIN=/opt/homebrew/bin/opencode

# Per-tool monthly budget overrides (USD; default in budget-check.sh)
# PHANTOM_BUDGET_CLAUDE_USD=50
# PHANTOM_BUDGET_CODEX_USD=30
# PHANTOM_BUDGET_GEMINI_USD=10
# PHANTOM_BUDGET_AGY_USD=10
# PHANTOM_BUDGET_OPENCODE_USD=10

# Force agy to accept long prompts (default refuses > 200 lines)
# AGY_FORCE=1
# AGY_LINE_LIMIT=500

# Skip 'phantom login' during install.sh (set if running headless / no broker)
# PHANTOM_INSTALL_SKIP_LOGIN=1
# PHANTOM_INSTALL_SKIP_CLUSTER=1
# PHANTOM_INSTALL_NO_LAUNCHD=1
