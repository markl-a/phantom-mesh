# ============================================================================
# Clawtex-Core Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── LLM Provider API Keys (optional — depends on which providers you use) ────
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Search API Keys (at least one recommended for web_search tool) ───────────
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=

# ── Email / SMTP (optional — needed for email_send tool) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── PostgreSQL (optional — for pgvector semantic memory backend) ─────────────
# CLAWTEX_PG_URL=postgresql://user:pass@host:5432/clawtex

# ── Logging ──────────────────────────────────────────────────────────────────
RUST_LOG=info
