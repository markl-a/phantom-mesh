# ============================================================================
# Clawtex-Core Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── LLM Provider API Keys (optional — depends on which providers you use) ────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# ── Search API Keys (at least one recommended for web_search tool) ───────────
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=

# ── Email / SMTP (optional — needed for email_send tool) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Email / IMAP (optional — needed for email_receive tool) ──────────────────
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=

# ── Cluster ──────────────────────────────────────────────────────────────────
# CLUSTER_SECRET=your-cluster-shared-secret
# CLAWTEX_NODE_ID=node-1

# ── Stripe / Revenue (optional — needed for payment tracking) ────────────────
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Render Deployment (optional) ─────────────────────────────────────────────
# RENDER_API_KEY=

# ── GitHub (optional — needed for github tool) ───────────────────────────────
# GITHUB_TOKEN=ghp_...

# ── YouTube (optional — needed for youtube_upload tool) ──────────────────────
# YOUTUBE_API_KEY=
# YOUTUBE_OAUTH_TOKEN=

# ── Media Generation (optional) ──────────────────────────────────────────────
# SUNO_API_KEY=
# UDIO_API_KEY=
# ELEVENLABS_API_KEY=

# ── PostgreSQL (optional — for pgvector semantic memory backend) ─────────────
# CLAWTEX_PG_URL=postgresql://user:pass@host:5432/clawtex

# ── Logging ──────────────────────────────────────────────────────────────────
RUST_LOG=info
