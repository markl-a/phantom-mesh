# Clawtex Sandbox — Ubuntu desktop for Computer Use
# Provides: Xvfb + Openbox + Tint2 + xdotool + scrot + VNC + noVNC
#
# Build: docker build -t clawtex-sandbox -f docker/Dockerfile.sandbox .
# Run:   docker run -d --name clawtex-sandbox -p 5900:5900 -p 6080:6080 clawtex-sandbox
# View:  http://localhost:6080 (noVNC web client)

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:1
ENV WIDTH=1024
ENV HEIGHT=768

# Install desktop environment and tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Virtual display
    xvfb \
    # Window manager + panel (openbox works in Xvfb; mutter does NOT)
    openbox tint2 \
    # Input automation
    xdotool \
    # Screenshot capture
    scrot \
    # Image manipulation (for resize)
    imagemagick \
    # VNC server
    x11vnc \
    # noVNC web client
    novnc websockify \
    # Common applications
    xterm \
    # File manager
    pcmanfm \
    # Text editor
    mousepad \
    # Utilities
    curl wget git python3 python3-pip \
    dbus-x11 software-properties-common \
    fonts-liberation fonts-noto-cjk \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Firefox from Mozilla PPA (Ubuntu 22.04 snap version doesn't work in Docker)
RUN curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x0AB215679C571D1C8325275B9BDB3D89CE49EC21" \
      | gpg --dearmor -o /etc/apt/trusted.gpg.d/mozillateam-ppa.gpg && \
    echo "deb http://ppa.launchpad.net/mozillateam/ppa/ubuntu jammy main" \
      > /etc/apt/sources.list.d/mozillateam-ppa.list && \
    printf 'Package: firefox*\nPin: release o=LP-PPA-mozillateam\nPin-Priority: 1001\n' \
      > /etc/apt/preferences.d/mozilla-firefox && \
    apt-get update && apt-get install -y --allow-downgrades firefox && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Create a non-root user for the sandbox
RUN useradd -m -s /bin/bash sandbox && \
    mkdir -p /home/sandbox/Desktop && \
    chown -R sandbox:sandbox /home/sandbox

# Configure tint2 panel
RUN mkdir -p /home/sandbox/.config/tint2 && \
    echo 'panel_position = bottom center horizontal' > /home/sandbox/.config/tint2/tint2rc && \
    chown -R sandbox:sandbox /home/sandbox/.config

# Startup script (sed converts CRLF→LF in case of Windows line endings)
COPY docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

EXPOSE 5900 6080

USER sandbox
WORKDIR /home/sandbox

ENTRYPOINT ["/entrypoint.sh"]
