<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.spectynmesh.autoevolve</string>

  <key>ProgramArguments</key>
  <array>
    <string>__SPECTYN_BIN__</string>
    <string>autoevolve</string>
    <string>--once</string>
    <string>--target</string>
    <string>__TARGET__</string>
    <string>--max-rounds</string>
    <string>__MAX_ROUNDS__</string>
    <string>--agent</string>
    <string>__AGENT__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- ~/.cargo/bin first so `cargo` is reachable for autoevolve's
         cargo-check/cargo-test loop (rustup-managed toolchain lives there).
         Then standard system paths. -->
    <key>PATH</key>
    <string>__HOME__/.cargo/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
__EXTRA_ENV__
  </dict>

  <key>StartInterval</key>
  <integer>__INTERVAL_SECS__</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/spectyn-autoevolve.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/spectyn-autoevolve.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
