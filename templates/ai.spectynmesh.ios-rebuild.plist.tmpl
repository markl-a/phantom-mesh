<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.phantommesh.ios-rebuild</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/make</string>
    <string>-C</string>
    <string>__WORK_DIR__</string>
    <string>ios-rebuild</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__WORK_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:__HOME__/.cargo/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>APPLE_TEAM_ID</key>
    <string>__APPLE_TEAM_ID__</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/spectyn-ios-rebuild.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/spectyn-ios-rebuild.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
